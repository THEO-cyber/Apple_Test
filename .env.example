# Port the Express gateway listens on
PORT=3000

# URL of the Python FastAPI inference server
PYTHON_API_URL=http://localhost:8000

# Gate model threshold — score below this means "not a plant" (default: 0.60)
GATE_THRESHOLD=0.60

# Minimum confidence for disease/rotten classes (default: 0.80)
MIN_CONFIDENCE=0.80

# Stricter threshold for healthy/fresh classes — these attract random images
# because they look like normal clean photos (default: 0.90)
MIN_CONFIDENCE_HEALTHY=0.90

# How many new feedback images trigger an automatic retrain (default: 10)
RETRAIN_THRESHOLD=10
